<div class="auth-page">
  <div class="auth-card">
    <div class="auth-header">
      <h2>Change Your Password</h2>
      <p>Create a secure, memorable password.</p>
    </div>
    <% resource.errors.full_messages_for(:reset_password_token).each do |message| %>
      <div class="flash flash-error">
        <%= message %>
      </div>
    <% end %>
    <%= form_for resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "auth-form" } do |f| %>
      <%= f.hidden_field :reset_password_token %>
      <div class="form-group">
        <%= f.label :password, "New Password" %>
        <% if @minimum_password_length %>
          <small class="password-hint">
            <%= @minimum_password_length %> characters minimum
          </small>
        <% end %>
        <div class="password-wrapper">
          <%= f.password_field :password, id: "reset_password", autofocus: true, autocomplete: "new-password", placeholder: "Enter your new password",
                class: ("form-control field-error" if resource.errors[:password].any?) || "form-control" %>
          <button type="button" class="toggle-password" data-target="reset_password" aria-label="Show password" aria-pressed="false">
            <i class="fa-regular fa-eye" aria-hidden="true"></i>
          </button>
        </div>
        <% resource.errors.full_messages_for(:password).each do |message| %>
          <small class="field-error-message"><%= message %></small>
        <% end %>
      </div>
      <div class="form-group">
        <%= f.label :password_confirmation, "Confirm New Password" %>
        <div class="password-wrapper">
          <%= f.password_field :password_confirmation, id: "reset_password_confirmation", autocomplete: "new-password", placeholder: "Confirm your new password",
                class: ("form-control field-error" if resource.errors[:password_confirmation].any?) || "form-control" %>
          <button type="button" class="toggle-password" data-target="reset_password_confirmation" aria-label="Show password" aria-pressed="false">
            <i class="fa-regular fa-eye" aria-hidden="true"></i>
          </button>
        </div>
        <% resource.errors.full_messages_for(:password_confirmation).each do |message| %>
          <small class="field-error-message"><%= message %></small>
        <% end %>
      </div>
      <div class="form-actions">
        <%= f.submit "Change My Password", class: "button auth-button" %>
      </div>
    <% end %>
      <%= render "devise/shared/links" %>
  </div>
</div>
