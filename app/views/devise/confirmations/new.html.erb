<div class="auth-page">
  <div class="auth-card">
    <div class="auth-header">
      <h2>Resend Confirmation</h2>
      <p>Enter your email to receive a new confirmation link.</p>
    </div>
    <%= form_for resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post, class: "auth-form" } do |f| %>
      <div class="form-group">
        <%= f.label :email, "Email Address" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", value: ( resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email ),
              placeholder: "Enter your email address", class: "form-control #{'field-error' if resource.errors[:email].any?}" %>
        <% resource.errors.full_messages_for(:email).each do |message| %>
          <small class="field-error-message"><%= message %></small>
        <% end %>
      </div>
      <div class="form-actions">
        <%= f.submit "Resend Confirmation Instructions", class: "button auth-button" %>
      </div>
    <% end %>
    <div class="auth-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>