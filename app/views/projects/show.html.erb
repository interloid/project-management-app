<div class="page-header">
  <div>
    <h1><%= @project.name %></h1>
    <p>Project details and information</p>
  </div>
  <div class="actions">
    <% if policy(@project).edit? %>
      <%= link_to "Edit Project", edit_project_path(@project), class: "button button-secondary" %>
    <% end %>
    <%= link_to "Back to Projects", projects_path, class: "button button-secondary" %>
  </div>
</div>
<div class="card">
  <div class="project-detail">
    <h3>Project Information</h3>
    <p>
      <strong>Name:</strong>
      <%= @project.name %>
    </p>
    <p>
      <strong>Description:</strong>
      <%= @project.description %>
    </p>
    <p>
      <strong>Status:</strong>
      <%= @project.status.humanize %>
    </p>
    <p>
      <strong>Start Date:</strong>
      <%= @project.start_date %>
    </p>
    <p>
      <strong>End Date:</strong>
      <%= @project.end_date %>
    </p>
    <p>
      <strong>Owner:</strong>
      <%= @project.owner.name %>
    </p>
  </div>
</div>
<div class="card">
  <h3>Project Members</h3>
  <% if @project.members.any? %>
    <ul>
      <% @project.members.each do |member| %>
        <li>
          <strong><%= member.name %></strong> - <%= member.email %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>No members have been added to this project.</p>
  <% end %>
</div>
<div class="card">
  <h3>Tasks</h3>
  <% if @project.tasks.any? %>
    <ul>
      <% @project.tasks.each do |task| %>
        <li>
          <%= link_to task.title, task_path(task) %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>No tasks have been created for this project.</p>
  <% end %>
</div>
<div class="card">
  <h2>Attachments</h2>
  <% if @project.attachments.attached? %>
    <div class="attachments">
      <% @project.attachments.each do |attachment| %>
        <div class="attachment-item">
          <span> <%= attachment.filename %> </span>
          <%= link_to "Download", rails_blob_path(attachment, disposition: "attachment"), class: "button button-secondary" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p>No attachments uploaded.</p>
  <% end %>
</div>
<div class="card">
  <h2>Comments</h2>
  <% if @comments.any? %>
    <div class="comments-list">
      <% @comments.each do |comment| %>
        <div class="comment-item">
          <div class="comment-header">
            <strong> <%= comment.user.name %> </strong>
            <small> <%= comment.created_at.strftime("%d %B %Y, %I:%M %p") %> </small>
          </div>
          <div class="comment-content">
            <%= simple_format(comment.content) %>
          </div>
          <div class="comment-actions">
            <% if policy(comment).edit? %>
              <%= link_to "Edit", edit_project_comment_path(@project, comment), class: "button button-secondary" %>
            <% end %>
            <% if policy(comment).destroy? %>
              <%= button_to "Delete", project_comment_path(@project, comment), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this comment?" },
                    class: "button button-danger" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p>No comments yet.</p>
  <% end %>
  <div class="comment-form">
    <h3>Add Comment</h3>
    <%= form_with model: [@project, Comment.new] do |form| %>
      <div class="form-group">
        <%= form.label :content, "Comment" %>
        <%= form.text_area :content, rows: 4, placeholder: "Write your comment..." %>
      </div>
      <%= form.submit "Add Comment", class: "button button-primary" %>
    <% end %>
  </div>
</div>
<div class="actions">
  <% if policy(@project).destroy? %>
    <%= button_to "Delete Project", @project, method: :delete, data: { turbo_confirm: "Are you sure you want to delete this project?" },
    class: "button button-danger" %>
  <% end %>
</div>