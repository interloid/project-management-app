<div class="page-header">
  <div>
    <h1>Projects</h1>
    <p>Manage and track your projects.</p>
  </div>
  <% if policy(Project).create? %>
    <%= link_to "New Project", new_project_path, class: "button button-primary" %>
  <% end %>
</div>
<div class="projects-grid">
  <% if @projects.any? %>
    <% @projects.each do |project| %>
      <div class="project-card">
        <div class="project-card-header">
          <div>
            <h2> <%= link_to project.name, project_path(project) %> </h2>
            <p class="project-owner"> Owned by <strong><%= project.owner.name %></strong> </p>
          </div>
          <span class="project-status status-<%= project.status %>">
            <%= project.status.humanize %>
          </span>
        </div>
        <div class="project-card-body">
          <p class="project-description"> <%= project.description.presence || "No project description available." %> </p>
          <div class="project-meta">
            <div class="meta-item">
              <span class="meta-label">Start Date</span>
              <span class="meta-value">
                <%= project.start_date || "Not set" %>
              </span>
            </div>
            <div class="meta-item">
              <span class="meta-label">End Date</span>
              <span class="meta-value">
                <%= project.end_date || "Not set" %>
              </span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Members</span>
              <span class="meta-value">
                <%= @member_counts.fetch(project.id, 0) %>
              </span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Tasks</span>
              <span class="meta-value">
                <%= @task_counts.fetch(project.id, 0) %>
              </span>
            </div>
          </div>
        </div>
        <div class="project-card-footer">
          <%= link_to "View Project", project_path(project), class: "button button-secondary" %>
          <div class="project-actions">
            <% if policy(project).edit? %>
              <%= link_to "Edit", edit_project_path(project), class: "button button-secondary" %>
            <% end %>
            <% if policy(project).destroy? %>
              <%= button_to "Delete", project_path(project), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this project?" },
              class: "button button-danger" %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="empty-state">
      <h2>No Projects Found</h2>
      <p>There are currently no projects available.</p>
      <% if policy(Project).create? %>
        <%= link_to "Create Project", new_project_path, class: "button button-primary" %>
      <% end %>
    </div>
  <% end %>
</div>

