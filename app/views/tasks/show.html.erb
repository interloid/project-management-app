<div class="page-header">
  <div>
    <h1><%= @task.title %></h1>
    <p>Project: <strong> <%= @task.project.name %> </strong> </p>
  </div>
  <div class="actions">
    <% if policy(@task).edit? %>
      <%= link_to "Edit", edit_task_path(@task), class: "button button-primary" %>
    <% end %>
    <%= link_to "Back", tasks_path, class: "button button-secondary" %>
  </div>
</div>
<div class="task-show-grid">
  <div class="card">
    <h2>Task Details</h2>
    <div class="detail-row">
      <strong>Description</strong>
      <p> <%= simple_format(@task.description) %> </p>
    </div>
    <div class="detail-row">
      <strong>Status</strong>
      <span class="status-badge status-<%= @task.status %>">
        <%= @task.status&.humanize || "Notset" %>
      </span>
    </div>
    <div class="detail-row">
      <strong>Priority</strong>
      <span class="priority-<%= @task.priority %>">
        <%= @task.priority&.humanize || "Not Set " %>
      </span>
    </div>
    <div class="detail-row">
      <strong>Start Date</strong>
      <span> <%= @task.start_date.strftime("%d %B %Y") %> </span>
    </div>
    <div class="detail-row">
      <strong>End Date</strong>
      <span> <%= @task.end_date.strftime("%d %B %Y") %> </span>
    </div>
  </div>
  <div class="card">
    <h2>Assignment</h2>
    <div class="detail-row">
      <strong>Project</strong>
      <%= link_to @task.project.name, project_path(@task.project) %>
    </div>
    <div class="detail-row">
      <strong>Assignee</strong>
      <span> <%= @task.assignee.name %> </span>
    </div>
  </div>
</div>
<div class="card">
  <h2>Attachments</h2>
  <% if @task.attachments.attached? %>
    <div class="attachments">
      <% @task.attachments.each do |attachment| %>
        <div class="attachment-item">
          <span> <%= attachment.filename %> </span>
          <%= link_to "Download", rails_blob_path(attachment, disposition: "attachment"), class: "button button-secondary" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p>No attachments uploaded.</p>
  <% end %>
</div>
<div class="card">
  <h2>Comments</h2>
  <% if @task.comments.any? %>
    <div class="comments-list">
      <% @task.comments.order(created_at: :desc).each do |comment| %>
        <div class="comment-item">
          <div class="comment-header">
            <strong> <%= comment.user.name %> </strong>
            <small> <%= comment.created_at.strftime("%d %B %Y, %I:%M %p") %> </small>
          </div>
          <div class="comment-content">
            <%= simple_format(comment.content) %>
          </div>
          <div class="comment-actions">
            <% if policy(comment).edit? %>
              <%= link_to "Edit", edit_task_comment_path(@task, comment), class: "button button-secondary" %>
            <% end %>
            <% if policy(comment).destroy? %>
              <%= button_to "Delete", task_comment_path(@task, comment), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this comment?" },
                    class: "button button-danger" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p>No comments yet.</p>
  <% end %>
  <div class="comment-form">
    <h3>Add Comment</h3>
    <%= form_with model: [@task, Comment.new] do |form| %>
      <div class="form-group">
        <%= form.label :content, "Comment" %>
        <%= form.text_area :content, rows: 4, placeholder: "Write your comment..." %>
      </div>
      <%= form.submit "Add Comment", class: "button button-primary" %>
    <% end %>
  </div>
</div>
<% if policy(@task).destroy? %>
  <div class="card danger-zone">
    <h2>Danger Zone</h2>
    <p> Deleting this task cannot be undone. </p>
    <%= button_to "Delete Task", task_path(@task), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this task?" },
    class: "button button-danger" %>
  </div>
<% end %>
