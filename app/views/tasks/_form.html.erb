<%= form_with model: @task, id: "task-form", local: true do |form| %>
  <div class="form-group">
    <%= form.label :title do %>
      Task Title<span class="required-star">*</span>
    <% end %>
    <%= form.text_field :title, placeholder: "Enter task title", autofocus: true, class: ("field-error" if task.errors[:title].any?) %>
    <% task.errors.full_messages_for(:title).each do |message| %>
      <small class="field-error-message"><%= message %></small>
    <% end %>
  </div>
  <div class="form-group">
    <%= form.label :description, class: "description-label" do %>
      <span class="label-title">Description</span><span class="optional-label">(optional)</span>
    <% end %>
    <%= form.text_area :description, rows: 5, placeholder: "Describe the task..." %>
  </div>
  <div class="form-row">
    <div class="form-group">
      <%= form.label :project_id do %>
        Project<span class="required-star">*</span>
      <% end %>
      <%= form.collection_select :project_id, @projects, :id, :name, { prompt: "Select Project" }, { id: "task_project_id",
          class: ( "field-error" if task.errors[:project_id].any? || task.errors[:project].any? ) } %>
      <% (task.errors.full_messages_for(:project_id) + task.errors.full_messages_for(:project)).uniq.each do |message| %>
        <small class="field-error-message"><%= message %></small>
      <% end %>
    </div>
    <div class="form-group">
      <%= form.label :assignee_id do %>
        Assignee<span class="required-star">*</span>
      <% end %>
      <%= form.select :assignee_id, options_from_collection_for_select(@assignees, :id, :name, task.assignee_id), { prompt: "Select Assignee" },
            { id: "task_assignee_id", class: ( "field-error" if task.errors[:assignee_id].any? || task.errors[:assignee].any? ) } %>
      <% (task.errors.full_messages_for(:assignee_id) + task.errors.full_messages_for(:assignee)).uniq.each do |message| %>
        <small class="field-error-message"><%= message %></small>
      <% end %>
    </div>
  </div>
  <div class="form-row">
    <div class="form-group">
      <%= form.label :priority %>
      <%= form.select :priority, Task.priorities.keys.map { |priority| [priority.humanize, priority] }, { prompt: "Select Priority" } %>
    </div>
    <div class="form-group">
      <%= form.label :status %>
      <%= form.select :status, Task.statuses.keys.map { |status| [status.humanize, status] }, { prompt: "Select Status" } %>
    </div>
  </div>
  <div class="form-group">
    <%= form.label :start_date do %>
        Start date<span class="required-star">*</span>
    <% end %>
    <%= form.date_field :start_date, class: ("field-error" if task.errors[:start_date].any?)  %>
    <% task.errors.full_messages_for(:start_date).each do |message| %>
      <small class="field-error-message"><%= message %></small>
    <% end %>
  </div>
  <div class="form-group">
    <%= form.label :end_date do %>
      End date<span class="required-star">*</span>
    <% end %>
    <%= form.date_field :end_date, class: ("field-error" if task.errors[:end_date].any?)  %>
    <% task.errors.full_messages_for(:end_date).each do |message| %>
      <small class="field-error-message"><%= message %></small>
    <% end %>
  </div>
  <div class="form-group">
    <%= form.label :attachments, class: "description-label" do %>
      <span class="label-title">Attachments</span><span class="optional-label">(optional)</span>
    <% end %>
    <% if task.persisted? && task.attachments.attached? %>
      <div class="existing-attachments">
        <% task.attachments.each do |attachment| %>
          <div class="attachment-name">
            <%= attachment.filename %>
            <label> <%= check_box_tag "task[remove_attachment_ids][]", attachment.id, false, id: "remove_attachment_#{attachment.id}" %></label>
          </div>
        <% end %>
      </div>
    <% end %>
    <%= form.file_field :attachments, multiple: true, direct_upload: true, id: "task_attachments" %>
    <small> Optional. You can upload one or more files. </small>
    <div id="pending-attachments">
      <% if params.dig(:task, :attachments).present? %>
        <% Array(params[:task][:attachments]).each do |signed_id| %>
          <% blob = ActiveStorage::Blob.find_signed(signed_id) rescue nil %>
          <% if blob %>
            <div class="pending-attachment" data-signed-id="<%= signed_id %>">
              <span> 📎 <%= blob.filename %> </span>
              <button type="button" class="remove-attachment"> X </button>
              <%= hidden_field_tag "task[attachments][]", signed_id, data: { attachment_id: signed_id } %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
  <div class="form-actions">
    <%= form.submit( task.persisted? ? "Update Task" : "Create Task", class: "button button-primary" ) %>
    <%= link_to "Cancel", tasks_path, class: "button button-secondary" %>
  </div>
<% end %>
